# TerraNexus Environment Configuration

# Flask Core
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=terranexus_dev_secret_key_change_in_production_89418291

# Database Configuration (MySQL / SQLite)
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=terranexus_db

# Default to SQLite if MySQL is not configured or not running
DATABASE_URL=sqlite:///terranexus.db

# App Settings
APP_NAME=TerraNexus
DEBUG=True
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_DURATION=604800
