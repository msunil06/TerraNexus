# TerraNexus Environment Configuration Template
# Copy this file to .env and adjust with your own private credentials.
# NEVER commit your actual .env file to GitHub.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=production
DEBUG=False
SECRET_KEY=replace_with_a_secure_random_hex_string_generate_using_secrets_token_hex

# -------------------------------------------------------------
# 1. Option A: Microsoft SQL Server / Azure SQL Database (Online)
# -------------------------------------------------------------
DB_SERVER=your-sql-server.database.windows.net
DB_PORT=1433
DB_NAME=your-database-name
DB_USER=your-database-username
DB_PASSWORD=your-database-password

# -------------------------------------------------------------
# 2. Option B: MySQL Database
# -------------------------------------------------------------
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=terranexus_db

# -------------------------------------------------------------
# 3. Option C: SQLite (Local Fallback)
# -------------------------------------------------------------
# If neither Azure SQL nor MySQL is configured, TerraNexus automatically falls back to:
DATABASE_URL=sqlite:///terranexus.db

# App Settings
APP_NAME=TerraNexus
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_DURATION=604800
